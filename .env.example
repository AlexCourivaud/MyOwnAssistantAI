# .env.example — My Own AI Assistant
#
# Template des variables d'environnement.
# Copie ce fichier en .env et ajuste les valeurs si nécessaire.
# Le fichier .env ne doit jamais être commité sur Git.
#
# Usage : cp .env.example .env

# --- Ollama ---
# URL de l'API Ollama (défaut : Docker en local)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle LLM à utiliser
MODEL_NAME=llama3.2:3b

# Durée pendant laquelle Ollama garde le modèle chargé en mémoire après un appel.
# -1 = indéfiniment | 30m = 30 minutes | 0 = décharge immédiatement
KEEP_ALIVE=30m

# Nombre maximum de tokens générés par réponse (borne le temps de génération)
NUM_PREDICT=700

# --- Historique ---
# Chemin vers la base SQLite de l'historique des conversations
DB_PATH=chat_history.db

# Identifiant de la conversation active. Changer cette valeur = nouvelle conversation.
SESSION_ID=default

# --- RAG (Phase 3) ---
# Modèle d'embeddings pour le RAG
# Doit être identique dans ingest.py et app.py — les deux lisent cette variable.
# Changer ce modèle oblige à relancer python ingest.py pour réindexer.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Seuil de distance RAG : extraits au-delà de ce seuil sont ignorés (plus petit = plus proche).
# À calibrer avec les logs "Retrieval" après le premier lancement.
# Avec des vecteurs normalisés en distance L2, les valeurs vont de 0 à 4.
# Un bon extrait tombe souvent sous 1.0.
# RAG_MAX_DISTANCE=1.0

# Taille des chunks lors de l'ingestion (en caractères)
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
